
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>TODO管理</title>

  <link rel="stylesheet" href="/todo/todo.css">
  <script src="/todo/todo.js" defer></script>
</head>
<body>
  <main>
    <h1>TODO管理</h1>

    <section aria-labelledby="create-heading">
      <h2 id="create-heading">TODOを登録</h2>

      <form id="todo-form" class="todo-form">
        <input
          id="todo-title"
          type="text"
          name="title"
          placeholder="TODOを入力してください"
          maxlength="100"
          required
          aria-label="TODOタイトル"
        >

        <button id="add-button" type="submit">
          登録
        </button>
      </form>

      <p
        id="form-message"
        class="message"
        role="status"
        aria-live="polite"
      ></p>
    </section>

    <section aria-labelledby="list-heading">
      <h2 id="list-heading">TODO一覧</h2>

      <p
        id="list-message"
        class="message"
        role="status"
        aria-live="polite"
      >
        読み込み中...
      </p>

      <button
        id="retry-button"
        class="retry-button"
        type="button"
        hidden
      >
        再読み込み
      </button>

      <ul id="todo-list" class="todo-list"></ul>
    </section>
  </main>
</body>
</html>
